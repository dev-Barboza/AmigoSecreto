# Preenchidas automaticamente pela Vercel ao conectar o Upstash Redis (Storage > Upstash).
# Sem elas, o app roda localmente com um banco em memória (dados somem ao reiniciar).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Opcional: segredo extra para o hash dos PINs
PIN_SECRET=troque-isto
# Alternativa: qualquer Redis com URL redis:// (ex.: Redis Cloud pela Vercel)
# REDIS_URL=
